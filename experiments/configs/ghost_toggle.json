{
  "experiment_name": "ghost_toggle",
  "description": "Fix core parameters and compare runs with and without ghost neighbors.",
  "base_command": "build/buffcut",
  "k_values": [
    4,
    8,
    16,
    32,
    64,
    128,
    256
  ],
  "graphs": [
    {
      "name": "delaunay_n15",
      "path": "examples/delaunay_n15.graph"
    },
    {
      "name": "rgg_n_2_15_s0",
      "path": "examples/rgg_n_2_15_s0.graph"
    }
  ],
  "common_args": {
    "--batch_size": 16384,
    "--buffer_size": 131072,
    "--b_score": "haa",
    "--num_streams_passes": 1,
    "--write_log": true,
    "--collect_locality_metrics": true,
    "--use_queue": true,
    "--use_flat_g2l_map": true,
    "--output_filename": "/dev/null",
    "--benchmark": true
  },
  "variants": [
    {
      "name": "ghost_disabled",
      "args": {}
    },
    {
      "name": "ghost_enabled",
      "args": {
        "--enable_ghost": true,
        "--ghost_weight": 0.5,
        "--weight_non_ghost": 5
      }
    }
  ]
}
