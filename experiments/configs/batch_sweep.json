{
  "experiment_name": "batch_sweep",
  "description": "Fix buffer size and vary batch sizes to evaluate metrics and performance.",
  "base_command": "build/buffcut",
  "k_values": [
    4,
    8,
    16,
    32,
    64,
    128,
    256
  ],
  "graphs": [
    {
      "name": "delaunay_n15",
      "path": "examples/delaunay_n15.graph"
    },
    {
      "name": "rgg_n_2_15_s0",
      "path": "examples/rgg_n_2_15_s0.graph"
    }
  ],
  "common_args": {
    "--buffer_size": 131072,
    "--b_score": "haa",
    "--num_streams_passes": 1,
    "--write_log": true,
    "--collect_locality_metrics": true,
    "--use_queue": true,
    "--use_flat_g2l_map": true,
    "--output_filename": "/dev/null",
    "--benchmark": true
  },
  "variants": [
    {
      "name": "batch_8k",
      "args": {
        "--batch_size": 8192
      }
    },
    {
      "name": "batch_16k",
      "args": {
        "--batch_size": 16384
      }
    },
    {
      "name": "batch_32k",
      "args": {
        "--batch_size": 32768
      }
    },
    {
      "name": "batch_64k",
      "args": {
        "--batch_size": 65536
      }
    }
  ]
}
